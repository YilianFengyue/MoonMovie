<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoonMovie.Controls.SeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36"
    IsTabStop="False">

    <!-- Tall transparent hit area; the visible track is thin and thickens on hover. -->
    <Grid
        x:Name="HitArea"
        Background="Transparent"
        PointerCanceled="OnPointerCanceled"
        PointerCaptureLost="OnPointerCaptureLost"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased">

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <!-- Time preview that follows the pointer. -->
            <Border
                x:Name="Preview"
                Canvas.Top="-30"
                Padding="8,3,8,4"
                Background="{StaticResource MoonChromeAcrylicBrush}"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0">
                <TextBlock
                    x:Name="PreviewText"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="12"
                    Foreground="White"
                    Text="0:00" />
            </Border>
        </Canvas>

        <Grid x:Name="Track" Height="4" VerticalAlignment="Center" CornerRadius="2">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TrackScale" CenterY="2" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Background="#33FFFFFF" />
            <Border x:Name="BufferedFill" HorizontalAlignment="Left" Background="#59FFFFFF" />
            <!-- Buffering: a soft light sweeping along, the rhythm of Windows' indeterminate progress. -->
            <Border
                x:Name="Sweep"
                Width="160"
                HorizontalAlignment="Left"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.5" Color="#A6FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SweepOffset" X="-160" />
                </Border.RenderTransform>
            </Border>
            <Border x:Name="HoverFill" HorizontalAlignment="Left" Background="#33FFFFFF" Opacity="0" />
            <Border x:Name="PlayedFill" HorizontalAlignment="Left" Background="White" />
            <!-- Chapter / intro / outro marks: small gaps cut into the track. -->
            <Canvas x:Name="Marks" />
        </Grid>

        <Ellipse
            x:Name="Thumb"
            Width="14"
            Height="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="White"
            IsHitTestVisible="False"
            Opacity="0"
            Stroke="#40000000"
            StrokeThickness="1">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ThumbScale" CenterX="7" CenterY="7" ScaleX="0.4" ScaleY="0.4" />
                    <TranslateTransform x:Name="ThumbOffset" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
