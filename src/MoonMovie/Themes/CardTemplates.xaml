<ResourceDictionary
    x:Class="MoonMovie.Themes.CardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:MoonMovie.Animations"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:MoonMovie.ViewModels">

    <!-- Row: portrait poster, fixed width. -->
    <DataTemplate x:Key="PosterCardTemplate" x:DataType="vm:MediaCardViewModel">
        <Button
            Width="172"
            AutomationProperties.Name="{x:Bind Title}"
            Command="{x:Bind OpenCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.AmbientUrl="{x:Bind AmbientUrl}"
            motion:CardMotion.IsEnabled="True">
            <StackPanel>
                <Grid Height="258" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                    <Image imaging:ImageEx.DecodeWidth="172" imaging:ImageEx.Url="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                    <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                </Grid>
                <TextBlock Margin="2,10,2,0" Style="{StaticResource MoonCardTitleStyle}" Text="{x:Bind Title}" />
                <TextBlock Margin="2,3,2,0" Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Row: wide still with the title set into the image. -->
    <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="vm:MediaCardViewModel">
        <Button
            Width="356"
            AutomationProperties.Name="{x:Bind Title}"
            Command="{x:Bind OpenCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.AmbientUrl="{x:Bind AmbientUrl}"
            motion:CardMotion.IsEnabled="True">
            <Grid Height="200" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                <Image imaging:ImageEx.DecodeWidth="356" imaging:ImageEx.Url="{x:Bind BackdropUrl}" Stretch="UniformToFill" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.35" Color="#00000000" />
                            <GradientStop Offset="1" Color="#D9000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Margin="16,0,16,14" VerticalAlignment="Bottom">
                    <TextBlock
                        FontFamily="{StaticResource MoonFontBold}"
                        FontSize="17"
                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MoonCardMetaStyle}" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="{x:Bind Subtitle}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
            </Grid>
        </Button>
    </DataTemplate>

    <!-- B站 video: 16:9 cover with the duration set into it, two-line title, UP主 · plays · age. -->
    <DataTemplate x:Key="BiliVideoCardTemplate" x:DataType="vm:BiliVideoViewModel">
        <Button
            Width="300"
            AutomationProperties.Name="{x:Bind AutomationName}"
            Command="{x:Bind PlayCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            ToolTipService.ToolTip="{x:Bind Title}"
            motion:CardMotion.IsEnabled="True">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind PlayCommand}" Text="播放">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind OpenInBrowserCommand}" Text="在 B站打开">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE774;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <StackPanel>
                <Grid Height="169" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                    <Image imaging:ImageEx.DecodeWidth="300" imaging:ImageEx.Url="{x:Bind CoverUrl}" Stretch="UniformToFill" />
                    <Border
                        Margin="0,0,8,8"
                        Padding="6,1,6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#B3000000"
                        CornerRadius="4">
                        <TextBlock FontSize="11" Foreground="#F2FFFFFF" Text="{x:Bind DurationText}" />
                    </Border>
                    <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                </Grid>
                <TextBlock
                    Height="40"
                    Margin="2,10,2,0"
                    FontSize="14"
                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                    LineHeight="20"
                    MaxLines="2"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock Margin="2,4,2,0" Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Cast: round portrait, name, role. -->
    <DataTemplate x:Key="PersonCardTemplate" x:DataType="vm:PersonViewModel">
        <StackPanel Width="120" Spacing="0">
            <Grid Width="104" Height="104" HorizontalAlignment="Center" Background="{StaticResource MoonSurfaceRaisedBrush}" CornerRadius="52">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="30"
                    Foreground="{StaticResource MoonTextTertiaryBrush}"
                    Text="{x:Bind Initial}" />
                <Image imaging:ImageEx.DecodeWidth="104" imaging:ImageEx.Url="{x:Bind ProfileUrl}" Stretch="UniformToFill" />
                <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="52" />
            </Grid>
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource MoonCardTitleStyle}"
                Text="{x:Bind Name}"
                TextAlignment="Center" />
            <TextBlock
                Margin="0,3,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource MoonCardMetaStyle}"
                Text="{x:Bind Role}"
                TextAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Episode: still with a large quiet index, title and synopsis. -->
    <DataTemplate x:Key="EpisodeCardTemplate" x:DataType="vm:EpisodeViewModel">
        <Button
            Width="300"
            AutomationProperties.Name="{x:Bind Title}"
            Command="{x:Bind PlayCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.IsEnabled="True">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind PlayCommand}" Text="播放">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind DownloadCommand}" Text="下载这一集">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <StackPanel>
                <Grid Height="169" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                    <Image imaging:ImageEx.DecodeWidth="300" imaging:ImageEx.Url="{x:Bind StillUrl}" Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.45" Color="#00000000" />
                                <GradientStop Offset="1" Color="#B3000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock
                        Margin="14,0,0,8"
                        VerticalAlignment="Bottom"
                        FontFamily="{StaticResource MoonFontBold}"
                        FontSize="30"
                        Foreground="#E6FFFFFF"
                        Text="{x:Bind NumberText}" />
                    <Border
                        Width="40"
                        Height="40"
                        Margin="0,0,12,12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource MoonGlassAcrylicBrush}"
                        CornerRadius="20">
                        <FontIcon FontSize="14" Foreground="{StaticResource MoonTextPrimaryBrush}" Glyph="&#xF5B0;" />
                    </Border>
                    <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                </Grid>
                <TextBlock Margin="2,12,2,0" Style="{StaticResource MoonCardTitleStyle}" Text="{x:Bind Title}" />
                <TextBlock Margin="2,3,2,0" Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Meta}" />
                <TextBlock
                    Height="40"
                    Margin="2,6,2,0"
                    FontSize="12"
                    LineHeight="20"
                    MaxLines="2"
                    Style="{StaticResource MoonBodyStyle}"
                    Text="{x:Bind Overview}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Source panel row: selection bar, site, match detail, live latency. -->
    <DataTemplate x:Key="SourceRowTemplate" x:DataType="vm:SourceItemViewModel">
        <Button
            AutomationProperties.Name="{x:Bind SiteName}"
            Command="{x:Bind ChooseCommand}"
            Style="{StaticResource MoonListRowButtonStyle}">
            <Grid Padding="14,12,14,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1.5"
                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />

                <StackPanel Grid.Column="1" Opacity="{x:Bind ContentOpacity, Mode=OneWay}" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontFamily="{StaticResource MoonFontBold}"
                            FontSize="15"
                            Foreground="{StaticResource MoonTextPrimaryBrush}"
                            Text="{x:Bind SiteName}" />
                        <Border
                            Padding="6,1,6,2"
                            VerticalAlignment="Center"
                            Background="#24FFFFFF"
                            CornerRadius="4"
                            Visibility="{x:Bind BestVisibility, Mode=OneWay}">
                            <TextBlock FontSize="11" Foreground="{StaticResource MoonTextPrimaryBrush}" Text="推荐" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Detail}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Padding="10,4,10,5"
                    VerticalAlignment="Center"
                    Background="#12FFFFFF"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{x:Bind StateBrush, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource MoonTextSecondaryBrush}"
                            Text="{x:Bind LatencyText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Discover wall: fills the column; the aspect ratio sets the height. -->
    <DataTemplate x:Key="WallPosterTemplate" x:DataType="vm:MediaCardViewModel">
        <Button
            AutomationProperties.Name="{x:Bind Title}"
            Command="{x:Bind OpenCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.AmbientUrl="{x:Bind AmbientUrl}"
            motion:CardMotion.IsEnabled="True">
            <StackPanel>
                <tk:ConstrainedBox AspectRatio="2:3">
                    <Grid Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                        <Image imaging:ImageEx.DecodeWidth="260" imaging:ImageEx.Url="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                        <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                    </Grid>
                </tk:ConstrainedBox>
                <TextBlock Margin="2,10,2,0" Style="{StaticResource MoonCardTitleStyle}" Text="{x:Bind Title}" />
                <TextBlock Margin="2,3,2,0" Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Subtitle}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="WallLandscapeTemplate" x:DataType="vm:MediaCardViewModel">
        <Button
            AutomationProperties.Name="{x:Bind Title}"
            Command="{x:Bind OpenCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.AmbientUrl="{x:Bind AmbientUrl}"
            motion:CardMotion.IsEnabled="True">
            <tk:ConstrainedBox AspectRatio="16:10">
                <Grid Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                    <Image imaging:ImageEx.DecodeWidth="420" imaging:ImageEx.Url="{x:Bind BackdropUrl}" Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.4" Color="#00000000" />
                                <GradientStop Offset="1" Color="#E6000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Margin="18,0,18,18" VerticalAlignment="Bottom">
                        <TextBlock
                            FontFamily="{StaticResource MoonFontBold}"
                            FontSize="18"
                            Foreground="{StaticResource MoonTextPrimaryBrush}"
                            MaxLines="2"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MoonCardMetaStyle}" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="{x:Bind Subtitle}" />
                    </StackPanel>
                    <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                </Grid>
            </tk:ConstrainedBox>
        </Button>
    </DataTemplate>
    <!-- 继续观看: wide still, progress hairline, what plays next. Right-click for details / removal. -->
    <DataTemplate x:Key="ContinueCardTemplate" x:DataType="vm:WatchedItemViewModel">
        <Button
            Width="356"
            AutomationProperties.Name="{x:Bind AutomationName}"
            Command="{x:Bind OpenCommand}"
            Style="{StaticResource MoonCardButtonStyle}"
            motion:CardMotion.AmbientUrl="{x:Bind AmbientUrl}"
            motion:CardMotion.IsEnabled="True">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind DetailsCommand}" Text="查看详情">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind RemoveCommand}" Text="删除观看记录">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <StackPanel>
                <Grid Height="200" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="{StaticResource MoonCardRadius}">
                    <Image imaging:ImageEx.DecodeWidth="356" imaging:ImageEx.Url="{x:Bind BackdropUrl}" Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.5" Color="#00000000" />
                                <GradientStop Offset="1" Color="#B3000000" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border
                        Width="40"
                        Height="40"
                        Margin="0,0,14,20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource MoonGlassAcrylicBrush}"
                        CornerRadius="20">
                        <FontIcon FontSize="14" Foreground="{StaticResource MoonTextPrimaryBrush}" Glyph="&#xF5B0;" />
                    </Border>
                    <Grid
                        Height="3"
                        Margin="14,0,14,10"
                        VerticalAlignment="Bottom"
                        CornerRadius="1.5"
                        Visibility="{x:Bind ProgressVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind PlayedLength}" />
                            <ColumnDefinition Width="{x:Bind RemainingLength}" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource MoonTextPrimaryBrush}" />
                        <Border Grid.Column="1" Background="#38FFFFFF" />
                    </Grid>
                    <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource MoonCardRadius}" />
                </Grid>
                <TextBlock Margin="2,10,2,0" Style="{StaticResource MoonCardTitleStyle}" Text="{x:Bind Title}" />
                <TextBlock Margin="2,3,2,0" Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind CardMeta}" />
            </StackPanel>
        </Button>
    </DataTemplate>
</ResourceDictionary>
