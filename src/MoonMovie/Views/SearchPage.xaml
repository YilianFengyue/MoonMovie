<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:vm="using:MoonMovie.ViewModels"
    Background="{StaticResource MoonCanvasBrush}"
    XYFocusKeyboardNavigation="Enabled">

    <Page.Resources>
        <!-- Result row: poster, names, kind/genres/rating, synopsis. Hover previews the artwork full-window. -->
        <DataTemplate x:Key="ResultRowTemplate" x:DataType="vm:SearchResultViewModel">
            <Button
                AutomationProperties.Name="{x:Bind Title}"
                Command="{x:Bind OpenCommand}"
                GotFocus="OnResultFocused"
                PointerEntered="OnResultPointerEntered"
                Style="{StaticResource MoonListRowButtonStyle}"
                Tag="{x:Bind Self}">
                <Grid Padding="12" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="144" Background="{StaticResource MoonSurfaceBrush}" CornerRadius="6">
                        <!-- No artwork: a quiet film glyph instead of an empty box. -->
                        <FontIcon FontSize="22" Foreground="{StaticResource MoonTextTertiaryBrush}" Glyph="&#xE714;" />
                        <Image imaging:ImageEx.DecodeWidth="96" imaging:ImageEx.Url="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                        <Border BorderBrush="{StaticResource MoonCardStrokeBrush}" BorderThickness="1" CornerRadius="6" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                FontFamily="{StaticResource MoonFontBold}"
                                FontSize="20"
                                Foreground="{StaticResource MoonTextPrimaryBrush}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Padding="7,1,7,2"
                                VerticalAlignment="Center"
                                Background="#2EFFFFFF"
                                CornerRadius="4"
                                Visibility="{x:Bind ExactVisibility}">
                                <TextBlock FontSize="11" Foreground="{StaticResource MoonTextPrimaryBrush}" Text="最匹配" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MoonMetaStyle}" FontSize="13" Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind RatingVisibility}">
                                <FontIcon VerticalAlignment="Center" FontSize="12" Foreground="#F2C94C" Glyph="&#xE735;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="13"
                                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                                    Text="{x:Bind RatingText}" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource MoonCardMetaStyle}" FontSize="13" Text="{x:Bind Meta}" />
                        </StackPanel>
                        <!-- One measure for every row: a long synopsis must not set its own line length. -->
                        <TextBlock
                            MaxWidth="760"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            LineHeight="21"
                            MaxLines="2"
                            Style="{StaticResource MoonBodyStyle}"
                            Text="{x:Bind Overview}"
                            Visibility="{x:Bind OverviewVisibility}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <controls:AmbientBackdrop x:Name="Ambient" Opacity="0.5" />

        <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" VerticalAnchorRatio="NaN">
            <StackPanel Padding="0,104,0,72">
                <StackPanel Margin="{StaticResource MoonGutter}" Spacing="6">
                    <TextBlock Style="{StaticResource MoonOverlineStyle}" Text="搜索" />
                    <TextBlock
                        x:Name="QueryText"
                        FontSize="40"
                        LineHeight="48"
                        Style="{StaticResource MoonDisplayStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="14"
                            Height="14"
                            MinWidth="14"
                            MinHeight="14"
                            IsActive="True" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource MoonMetaStyle}" />
                    </StackPanel>
                    <SelectorBar x:Name="FilterBar" Margin="-12,12,0,0" SelectionChanged="OnFilterChanged">
                        <SelectorBarItem IsSelected="True" Tag="All" Text="全部" />
                        <SelectorBarItem Tag="Movie" Text="电影" />
                        <SelectorBarItem Tag="Tv" Text="剧集" />
                    </SelectorBar>
                </StackPanel>

                <!-- Rows share one width (the hover wash lines up), capped for readability. -->
                <Grid Margin="44,20,44,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1040" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsRepeater
                        x:Name="ResultsRepeater"
                        ItemTemplate="{StaticResource ResultRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Results}"
                        XYFocusKeyboardNavigation="Enabled">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>

                <controls:MediaRow
                    x:Name="PeopleRow"
                    Margin="0,40,0,0"
                    ItemTemplate="{StaticResource PersonCardTemplate}"
                    ItemsSource="{x:Bind ViewModel.People}"
                    Spacing="8"
                    Title="人物"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
