<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:playback="using:MoonMovie.Playback"
    xmlns:vm="using:MoonMovie.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Black">

    <!--
        Interaction-hosting layers animate with Storyboards only (see Animations/Motion.cs):
        composition is used solely for the centre glyph, which hosts nothing.
    -->

    <Page.Resources>
        <!-- A reply inside a thread: smaller avatar, no nested thread. -->
        <DataTemplate x:Key="BiliReplyTemplate" x:DataType="vm:BiliCommentViewModel">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="22"
                    Height="22"
                    VerticalAlignment="Top"
                    Background="{StaticResource MoonSurfaceRaisedBrush}"
                    CornerRadius="11">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource MoonTextTertiaryBrush}"
                        Text="{x:Bind Initial}" />
                    <Image imaging:ImageEx.DecodeWidth="22" imaging:ImageEx.Url="{x:Bind AvatarUrl}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock FontSize="12" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="{x:Bind User}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="20"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Text="{x:Bind Meta}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Glyph="&#xE8E1;" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Text="{x:Bind Likes}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- B站 comment: avatar, name (and 置顶), text, when · where · likes. -->
        <DataTemplate x:Key="BiliCommentTemplate" x:DataType="vm:BiliCommentViewModel">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="{StaticResource MoonSurfaceRaisedBrush}"
                    CornerRadius="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource MoonTextTertiaryBrush}"
                        Text="{x:Bind Initial}" />
                    <Image imaging:ImageEx.DecodeWidth="32" imaging:ImageEx.Url="{x:Bind AvatarUrl}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="12" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="{x:Bind User}" />
                        <Border
                            Padding="5,0,5,1"
                            VerticalAlignment="Center"
                            Background="#33FB7299"
                            CornerRadius="3"
                            Visibility="{x:Bind PinnedVisibility}">
                            <TextBlock FontSize="10" Foreground="#FB7299" Text="置顶" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="21"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Text="{x:Bind Meta}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Glyph="&#xE8E1;" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MoonTextTertiaryBrush}" Text="{x:Bind Likes}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- The thread: preview replies, then the full list on request. -->
                    <StackPanel
                        Margin="0,4,0,0"
                        Padding="12,10"
                        Background="#0AFFFFFF"
                        CornerRadius="8"
                        Spacing="12"
                        Visibility="{x:Bind ThreadVisibility}">
                        <ItemsRepeater ItemTemplate="{StaticResource BiliReplyTemplate}" ItemsSource="{x:Bind Replies}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.Name="{x:Bind ThreadActionText, Mode=OneWay}"
                                Command="{x:Bind MoreRepliesCommand}"
                                FontSize="12"
                                Foreground="{StaticResource MoonTextSecondaryBrush}"
                                Visibility="{x:Bind ThreadActionVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind ThreadActionText, Mode=OneWay}" />
                                    <FontIcon FontSize="10" Glyph="&#xE70D;" />
                                </StackPanel>
                            </HyperlinkButton>
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind Loading, Mode=OneWay}" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.Name="收起回复"
                                Command="{x:Bind CollapseRepliesCommand}"
                                FontSize="12"
                                Foreground="{StaticResource MoonTextTertiaryBrush}"
                                Visibility="{x:Bind CollapseVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="收起" />
                                    <FontIcon FontSize="10" Glyph="&#xE70E;" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="PanelLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MoonTextSecondaryBrush}" />
        </Style>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#33000000" />
        <DataTemplate x:Key="PlayerEpisodeTemplate" x:DataType="playback:PlayerEpisodeItem">
            <Button Click="OnEpisodeRowClick" Style="{StaticResource MoonListRowButtonStyle}" Tag="{x:Bind Index}">
                <Grid Padding="10" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="128"
                        Height="72"
                        Background="{StaticResource MoonSurfaceRaisedBrush}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MoonFontBold}"
                            FontSize="20"
                            Foreground="{StaticResource MoonTextTertiaryBrush}"
                            Text="{x:Bind Label}" />
                        <Image imaging:ImageEx.DecodeWidth="128" imaging:ImageEx.Url="{x:Bind StillUrl}" Stretch="UniformToFill" />
                        <Border
                            Background="#8C000000"
                            CornerRadius="6"
                            Visibility="{x:Bind CurrentVisibility, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Foreground="White" Glyph="&#xE768;" />
                                <TextBlock FontSize="12" Foreground="White" Text="正在播放" />
                            </StackPanel>
                        </Border>
                        <Border
                            Height="3"
                            Margin="6,0,6,5"
                            VerticalAlignment="Bottom"
                            Background="#4DFFFFFF"
                            CornerRadius="1.5"
                            Visibility="{x:Bind WatchedVisibility}">
                            <ProgressBar
                                Height="3"
                                MinHeight="3"
                                Foreground="White"
                                Maximum="1"
                                Value="{x:Bind Watched}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource MoonFontBold}"
                            FontSize="14"
                            Foreground="{StaticResource MoonTextPrimaryBrush}"
                            Text="{x:Bind Label}" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource MoonCardMetaStyle}"
                            FontSize="12"
                            Foreground="{StaticResource MoonTextSecondaryBrush}"
                            Text="{x:Bind Name}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>


    </Page.Resources>

    <Grid x:Name="Root" PointerMoved="OnPointerMoved" PointerExited="OnPointerExitedRoot">
        <!-- The engine's picture (mpv swap chain or MediaPlayerElement) is placed here. -->
        <Grid x:Name="VideoHost" IsHitTestVisible="False" />

        <!-- Clicks on the picture: toggle playback; double-click: full screen. -->
        <Rectangle
            x:Name="TapSurface"
            DoubleTapped="OnSurfaceDoubleTapped"
            Fill="Transparent"
            Tapped="OnSurfaceTapped" />

        <!-- Bullet comments: above the picture, below every piece of chrome. -->
        <controls:DanmakuOverlay x:Name="Danmaku" />

        <!-- ===== Opening / switching cover ===== -->
        <Grid x:Name="LoadingCover" IsHitTestVisible="False">
            <Image x:Name="LoadingBackdrop" imaging:ImageEx.DecodeWidth="1280" Opacity="0.4" Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#B3000000" />
                        <GradientStop Offset="0.5" Color="#80000000" />
                        <GradientStop Offset="1" Color="#F2000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <controls:DotsSpinner Width="46" Height="46" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="LoadingTitle"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="22"
                    Foreground="White"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="LoadingText"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MoonMetaStyle}"
                    FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Mid-playback buffering: the Windows dots in a small glass capsule, with how far along it is. -->
        <Border
            x:Name="BufferRing"
            Padding="16,11,20,11"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <controls:DotsSpinner Width="26" Height="26" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="BufferText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#F2FFFFFF"
                    Text="正在缓冲" />
            </StackPanel>
        </Border>

        <!-- ===== Paused: what you are watching ===== -->
        <StackPanel
            x:Name="PausedInfo"
            MaxWidth="620"
            Margin="72,0,72,40"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Opacity="0"
            Spacing="10">
            <TextBlock Style="{StaticResource MoonOverlineStyle}" Text="已暂停" />
            <TextBlock
                x:Name="PausedTitle"
                FontSize="44"
                LineHeight="52"
                Style="{StaticResource MoonDisplayStyle}" />
            <TextBlock x:Name="PausedMeta" Style="{StaticResource MoonMetaStyle}" FontSize="15" />
            <TextBlock
                x:Name="PausedOverview"
                Margin="0,6,0,0"
                MaxLines="4"
                Style="{StaticResource MoonBodyStyle}" />
        </StackPanel>

        <!-- ===== Seek ripples (left/right thirds) and HUD ===== -->
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <Grid
            x:Name="RippleBack"
            Width="150"
            Height="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#73000000"
            CornerRadius="75"
            IsHitTestVisible="False"
            Opacity="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <FontIcon FontSize="26" Foreground="White" Glyph="&#xEB9E;" />
                <TextBlock x:Name="RippleBackText" HorizontalAlignment="Center" FontSize="14" Foreground="White" />
            </StackPanel>
        </Grid>
        <Grid
            x:Name="RippleForward"
            Grid.Column="2"
            Width="150"
            Height="150"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#73000000"
            CornerRadius="75"
            IsHitTestVisible="False"
            Opacity="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <FontIcon FontSize="26" Foreground="White" Glyph="&#xEB9D;" />
                <TextBlock x:Name="RippleForwardText" HorizontalAlignment="Center" FontSize="14" Foreground="White" />
            </StackPanel>
        </Grid>
        </Grid>

        <Grid
            x:Name="CenterGlyphHost"
            Width="96"
            Height="96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#66000000"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="48"
            IsHitTestVisible="False">
            <FontIcon x:Name="CenterGlyph" FontSize="36" Foreground="White" Glyph="&#xE768;" />
        </Grid>

        <Border
            x:Name="Hud"
            Margin="0,84,0,0"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#D9141519"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="22"
            IsHitTestVisible="False"
            Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="HudGlyph" VerticalAlignment="Center" FontSize="16" Foreground="White" Glyph="&#xE767;" />
                <Grid Width="140" Height="4" VerticalAlignment="Center" Background="#40FFFFFF" CornerRadius="2">
                    <Border x:Name="HudFill" HorizontalAlignment="Left" Background="White" CornerRadius="2" />
                </Grid>
                <TextBlock
                    x:Name="HudText"
                    MinWidth="36"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="13"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <!-- With the controls hidden, a hairline at the very bottom still tells how far along it is. -->
        <Grid
            x:Name="MiniProgress"
            Height="2"
            VerticalAlignment="Bottom"
            Background="#1FFFFFFF"
            IsHitTestVisible="False"
            Opacity="0">
            <Border x:Name="MiniBuffered" HorizontalAlignment="Left" Background="#33FFFFFF" />
            <Border x:Name="MiniPlayed" HorizontalAlignment="Left" Background="#B3FFFFFF" />
        </Grid>

        <!-- ===== Chrome (auto-hides with the cursor and caption buttons) ===== -->
        <Grid x:Name="Chrome">
            <Rectangle Height="160" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#CC000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="240" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.55" Color="#99000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Header shares the title bar row with the back button; not hit-testable, so the window still drags. -->
            <StackPanel
                Margin="64,9,220,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Spacing="1">
                <TextBlock
                    x:Name="TitleText"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="15"
                    Foreground="White"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{StaticResource MoonTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid x:Name="BottomBar" Margin="28,0,28,16" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:SeekBar x:Name="SeekBar" Margin="8,0" />

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="PlayPauseButton"
                            Width="52"
                            Height="52"
                            AutomationProperties.Name="播放/暂停"
                            Click="OnPlayPauseClick"
                            CornerRadius="26"
                            Style="{StaticResource MoonPlayerIconButtonStyle}"
                            ToolTipService.ToolTip="播放/暂停 (空格)">
                            <FontIcon x:Name="PlayPauseGlyph" FontSize="24" Glyph="&#xE769;" />
                        </Button>
                        <Button AutomationProperties.Name="后退 10 秒" Click="OnBack10Click" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="后退 10 秒 (←)">
                            <FontIcon FontSize="19" Glyph="&#xEB9E;" />
                        </Button>
                        <Button AutomationProperties.Name="前进 10 秒" Click="OnForward10Click" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="前进 10 秒 (→)">
                            <FontIcon FontSize="19" Glyph="&#xEB9D;" />
                        </Button>
                        <Button x:Name="NextButton" AutomationProperties.Name="下一集" Click="OnNextClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="下一集 (N)">
                            <FontIcon FontSize="19" Glyph="&#xE893;" />
                        </Button>
                        <Button x:Name="MuteButton" Margin="6,0,0,0" AutomationProperties.Name="静音" Click="OnMuteClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="静音 (M)">
                            <FontIcon x:Name="VolumeGlyph" FontSize="19" Glyph="&#xE767;" />
                        </Button>
                        <Slider
                            x:Name="VolumeBar"
                            Width="96"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            IsThumbToolTipEnabled="False"
                            Maximum="100"
                            ValueChanged="OnVolumeChanged"
                            Value="100">
                            <!-- Neutral, cinema-style colours (no accent blue on video). -->
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#59FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#40FFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#33000000" />
                            </Slider.Resources>
                        </Slider>
                        <Button
                            x:Name="TimeButton"
                            VerticalAlignment="Center"
                            Click="OnTimeClick"
                            FontSize="13"
                            Foreground="White"
                            Style="{StaticResource MoonLinkButtonStyle}"
                            ToolTipService.ToolTip="切换剩余时间">
                            <TextBlock x:Name="TimeLabel" FontFamily="{StaticResource MoonFontBold}" Text="0:00 / 0:00" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="NowPlayingText"
                        Grid.Column="1"
                        MaxWidth="460"
                        Margin="16,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource MoonTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                        <!-- 弹幕: the badge fills when comments are on. -->
                        <Button
                            x:Name="DanmakuButton"
                            AutomationProperties.Name="弹幕开关"
                            Click="OnDanmakuToggleClick"
                            Style="{StaticResource MoonPlayerIconButtonStyle}"
                            ToolTipService.ToolTip="弹幕开关 (D)">
                            <Border
                                x:Name="DanmakuBadge"
                                Width="26"
                                Height="21"
                                Background="White"
                                BorderBrush="White"
                                BorderThickness="1.5"
                                CornerRadius="5">
                                <TextBlock
                                    x:Name="DanmakuBadgeText"
                                    Margin="0,0,0,1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="12"
                                    Foreground="Black"
                                    Text="弹" />
                            </Border>
                        </Button>
                        <Button AutomationProperties.Name="弹幕设置" Click="OnDanmakuSettingsClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="弹幕设置 (B)">
                            <FontIcon FontSize="18" Glyph="&#xE9E9;" />
                        </Button>
                        <Button
                            x:Name="SpeedButton"
                            Width="Auto"
                            MinWidth="60"
                            Padding="14,0"
                            AutomationProperties.Name="播放速度"
                            Style="{StaticResource MoonPlayerIconButtonStyle}"
                            ToolTipService.ToolTip="播放速度 ([ ])">
                            <TextBlock x:Name="SpeedText" FontFamily="{StaticResource MoonFontBold}" FontSize="14" Text="1.0x" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="SpeedMenu" Placement="Top" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="EpisodesButton" AutomationProperties.Name="选集" Click="OnEpisodesClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="选集 (E)">
                            <FontIcon FontSize="19" Glyph="&#xE8FD;" />
                        </Button>
                        <Button AutomationProperties.Name="片源" Click="OnSourcesClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="片源 (S)">
                            <FontIcon FontSize="19" Glyph="&#xE7F4;" />
                        </Button>
                        <Button x:Name="PipButton" AutomationProperties.Name="画中画" Click="OnPipClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="画中画 (P)">
                            <FontIcon x:Name="PipGlyph" FontSize="19" Glyph="&#xE8A7;" />
                        </Button>
                        <Button AutomationProperties.Name="全屏" Click="OnFullScreenClick" Style="{StaticResource MoonPlayerIconButtonStyle}" ToolTipService.ToolTip="全屏 (F)">
                            <FontIcon x:Name="FullScreenGlyph" FontSize="19" Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Up next ===== -->
        <Grid
            x:Name="NextCard"
            Width="400"
            Margin="0,0,40,128"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            BorderBrush="{StaticResource MoonHairlineBrush}"
            BorderThickness="1"
            ColumnSpacing="14"
            CornerRadius="10"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="86" Background="{StaticResource MoonSurfaceRaisedBrush}" CornerRadius="6">
                <Image x:Name="NextStill" imaging:ImageEx.DecodeWidth="152" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="NextCountdown" Style="{StaticResource MoonOverlineStyle}" />
                <TextBlock
                    x:Name="NextTitle"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="15"
                    Foreground="White"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        Height="34"
                        Padding="14,0"
                        Click="OnNextNowClick"
                        Content="立即播放"
                        FontSize="13"
                        Style="{StaticResource MoonPrimaryButtonStyle}" />
                    <Button
                        Height="34"
                        Padding="14,0"
                        Click="OnNextCancelClick"
                        Content="取消"
                        FontSize="13"
                        Style="{StaticResource MoonGlassButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Transient messages: resume point, ads removed, source switched. -->
        <Border
            x:Name="Toast"
            Margin="0,72,0,0"
            Padding="18,9,10,9"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#E6141519"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="20"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13" Foreground="White" />
                <Button
                    x:Name="ToastAction"
                    VerticalAlignment="Center"
                    Click="OnToastActionClick"
                    FontSize="13"
                    Style="{StaticResource MoonLinkButtonStyle}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Unrecoverable failure -->
        <StackPanel
            x:Name="ErrorPanel"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14"
            Visibility="Collapsed">
            <FontIcon FontSize="36" Foreground="{StaticResource MoonTextSecondaryBrush}" Glyph="&#xE7BA;" />
            <TextBlock
                x:Name="ErrorText"
                HorizontalAlignment="Center"
                Style="{StaticResource MoonBodyStyle}"
                TextAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Button Click="OnSourcesClick" Content="选择其他片源" Style="{StaticResource MoonPrimaryButtonStyle}" />
                <Button Click="OnRetryClick" Content="重试" Style="{StaticResource MoonGlassButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Playback info (I) ===== -->
        <Border
            x:Name="InfoPanel"
            Margin="28,76,0,0"
            Padding="16,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            BorderBrush="{StaticResource MoonHairlineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Grid x:Name="InfoRows" ColumnSpacing="18" RowSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <!-- ===== Side panel: episodes & sources ===== -->
        <Grid x:Name="SideLayer" Visibility="Collapsed">
            <Rectangle Fill="#1F000000" Tapped="OnSideDismissTapped" />
            <Grid
                x:Name="SidePanel"
                Width="470"
                Margin="0,60,12,12"
                HorizontalAlignment="Right"
                Background="{StaticResource MoonPanelAcrylicBrush}"
                BorderBrush="{StaticResource MoonPanelStrokeBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="14,12,10,6">
                    <SelectorBar x:Name="PanelTabs" SelectionChanged="OnPanelTabChanged">
                        <SelectorBarItem x:Name="EpisodesTab" Text="选集" />
                        <SelectorBarItem x:Name="SourcesTab" Text="片源" />
                        <SelectorBarItem x:Name="DanmakuTab" Text="弹幕" />
                        <SelectorBarItem x:Name="PictureTab" Text="画面" />
                        <SelectorBarItem x:Name="AudioTab" Text="声音" />
                        <SelectorBarItem x:Name="SubtitleTab" Text="字幕" />
                        <SelectorBarItem x:Name="CommentsTab" Text="评论" />
                    </SelectorBar>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="关闭"
                        Click="OnSideDismiss"
                        Style="{StaticResource MoonTitleBarButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="EpisodesView" Grid.Row="1" Padding="8,4,8,8" HorizontalScrollMode="Disabled">
                    <ItemsRepeater x:Name="EpisodesRepeater" ItemTemplate="{StaticResource PlayerEpisodeTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
                <ScrollViewer x:Name="SourcesView" Grid.Row="1" Padding="8,4,8,8" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <ItemsRepeater x:Name="SourcesRepeater" ItemTemplate="{StaticResource SourceRowTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- ===== 弹幕 ===== -->
                <ScrollViewer x:Name="DanmakuView" Grid.Row="1" Padding="18,8,18,18" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <ScrollViewer.Resources>
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4DFFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#33000000" />
                    </ScrollViewer.Resources>
                    <StackPanel Spacing="22">
                        <!-- Status: what is attached, how many, and the master switch. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        x:Name="DanmakuRing"
                                        Width="14"
                                        Height="14"
                                        MinWidth="14"
                                        MinHeight="14"
                                        Foreground="White"
                                        IsActive="True"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="DanmakuStatusTitle"
                                        FontFamily="{StaticResource MoonFontBold}"
                                        FontSize="15"
                                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                                        Text="弹幕" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="DanmakuStatusDetail"
                                    FontSize="12"
                                    Style="{StaticResource MoonCardMetaStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="DanmakuPowerChip"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OnDanmakuToggleClick"
                                Style="{StaticResource MoonChipButtonStyle}" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="不透明度" />
                                <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" IsThumbToolTipEnabled="False" Maximum="100" Minimum="20" StepFrequency="5" ValueChanged="OnDanmakuSliderChanged" />
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="字号" />
                                <TextBlock x:Name="FontValue" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <Slider x:Name="FontSlider" IsThumbToolTipEnabled="False" Maximum="160" Minimum="60" StepFrequency="10" ValueChanged="OnDanmakuSliderChanged" />
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="滚动速度" />
                                <TextBlock x:Name="SpeedValue" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <Slider x:Name="DanmakuSpeedSlider" IsThumbToolTipEnabled="False" Maximum="200" Minimum="50" StepFrequency="10" ValueChanged="OnDanmakuSliderChanged" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="显示区域" />
                            <StackPanel x:Name="AreaChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="弹幕密度" />
                            <StackPanel x:Name="DensityChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="显示内容" />
                            <StackPanel x:Name="KindChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="时间轴校准" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button AutomationProperties.Name="弹幕提前 0.5 秒" Click="OnOffsetEarlier" Style="{StaticResource MoonTitleBarButtonStyle}" ToolTipService.ToolTip="提前 0.5 秒">
                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                </Button>
                                <TextBlock
                                    x:Name="OffsetText"
                                    MinWidth="84"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="13"
                                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                                    TextAlignment="Center" />
                                <Button AutomationProperties.Name="弹幕延后 0.5 秒" Click="OnOffsetLater" Style="{StaticResource MoonTitleBarButtonStyle}" ToolTipService.ToolTip="延后 0.5 秒">
                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Wrong show? Pick another one; the choice sticks for the rest of the season. -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="弹幕来源" />
                                <ProgressRing
                                    x:Name="CandidatesRing"
                                    Width="14"
                                    Height="14"
                                    MinWidth="14"
                                    MinHeight="14"
                                    HorizontalAlignment="Right"
                                    Foreground="White"
                                    IsActive="True"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBox
                                x:Name="DanmakuSearchBox"
                                KeyDown="OnDanmakuSearchKeyDown"
                                PlaceholderText="不对？输入片名回车搜索" />
                            <TextBlock x:Name="CandidatesEmpty" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                            <StackPanel x:Name="CandidatesList" Spacing="2" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 画面 ===== -->
                <ScrollViewer x:Name="PictureView" Grid.Row="1" Padding="18,8,18,18" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel Spacing="22">
                        <!-- B站 videos: the qualities B站 offers this account; locked ones say what unlocks them. -->
                        <StackPanel x:Name="BiliQualitySection" Spacing="8" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="B站画质" />
                                <TextBlock x:Name="BiliQualityNote" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <tk:WrapPanel x:Name="BiliQualityChips" HorizontalSpacing="4" VerticalSpacing="4" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="画质档位" />
                                <TextBlock x:Name="QualityNote" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <StackPanel x:Name="QualityChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="增强" />
                            <StackPanel x:Name="EnhanceChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>
                        <StackPanel x:Name="UpscaleSection" Spacing="8">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="超分辨率（本季记住）" />
                                <TextBlock x:Name="UpscaleNote" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <StackPanel x:Name="UpscaleChips" Orientation="Horizontal" Spacing="4" />
                            <TextBlock
                                FontSize="12"
                                Style="{StaticResource MoonCardMetaStyle}"
                                Text="Anime4K 适合动画；RTX 超分适合真人影视。片源小于窗口时才会启用，掉帧会自动降一档。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="画面比例" />
                            <StackPanel x:Name="AspectChips" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="画面调节" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="OnResetPicture"
                                    FontSize="12"
                                    Style="{StaticResource MoonLinkButtonStyle}">
                                    <TextBlock Text="重置" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="AdjustSliders" Spacing="2" />
                        </StackPanel>
                        <StackPanel x:Name="SkipSection" Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="跳过片头片尾（本季记住）" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IntroText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MoonTextPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Click="OnMarkIntro" FontSize="12" Style="{StaticResource MoonLinkButtonStyle}">
                                        <TextBlock Text="设为此处" />
                                    </Button>
                                    <Button Click="OnClearIntro" FontSize="12" Style="{StaticResource MoonLinkButtonStyle}">
                                        <TextBlock Text="清除" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OutroText" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MoonTextPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Click="OnMarkOutro" FontSize="12" Style="{StaticResource MoonLinkButtonStyle}">
                                        <TextBlock Text="设为此处" />
                                    </Button>
                                    <Button Click="OnClearOutro" FontSize="12" Style="{StaticResource MoonLinkButtonStyle}">
                                        <TextBlock Text="清除" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="工具" />
                            <StackPanel x:Name="ToolChips" Orientation="Horizontal" Spacing="4" />
                            <TextBlock
                                FontSize="12"
                                Style="{StaticResource MoonCardMetaStyle}"
                                Text="快捷键：Ctrl+S 截图 · , . 逐帧 · Ctrl+L A-B 循环 · I 播放信息"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 声音 ===== -->
                <ScrollViewer x:Name="AudioView" Grid.Row="1" Padding="18,8,18,18" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel Spacing="22">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="音轨" />
                            <StackPanel x:Name="AudioTrackList" Spacing="2" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="声音" />
                            <StackPanel x:Name="AudioChips" Orientation="Horizontal" Spacing="4" />
                            <TextBlock FontSize="12" Style="{StaticResource MoonCardMetaStyle}" Text="音量可放大到 150%（↑ 键或音量条）" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="音画同步（本季记住）" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button AutomationProperties.Name="声音提前 0.1 秒" Click="OnAudioEarlier" Style="{StaticResource MoonTitleBarButtonStyle}">
                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                </Button>
                                <TextBlock
                                    x:Name="AudioDelayText"
                                    MinWidth="96"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="13"
                                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                                    TextAlignment="Center" />
                                <Button AutomationProperties.Name="声音延后 0.1 秒" Click="OnAudioLater" Style="{StaticResource MoonTitleBarButtonStyle}">
                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="输出设备" />
                            <StackPanel x:Name="AudioDeviceList" Spacing="2" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 评论 (B站 videos): the video, then its hot comments ===== -->
                <ScrollViewer x:Name="CommentsView" Grid.Row="1" Padding="18,8,18,18" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="10">
                            <TextBlock
                                x:Name="BiliTitle"
                                FontFamily="{StaticResource MoonFontBold}"
                                FontSize="16"
                                Foreground="{StaticResource MoonTextPrimaryBrush}"
                                LineHeight="24"
                                MaxLines="3"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="BiliAuthorFaceHost" Width="28" Height="28" Background="{StaticResource MoonSurfaceRaisedBrush}" CornerRadius="14">
                                    <Image x:Name="BiliAuthorFace" imaging:ImageEx.DecodeWidth="28" Stretch="UniformToFill" />
                                </Grid>
                                <TextBlock
                                    x:Name="BiliAuthor"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource MoonTextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="OnOpenBiliInBrowser"
                                    FontSize="12"
                                    Style="{StaticResource MoonLinkButtonStyle}">
                                    <TextBlock Text="在 B站打开" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="BiliStats" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="BiliDescription"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                LineHeight="20"
                                MaxLines="5"
                                Style="{StaticResource MoonBodyStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="#14FFFFFF" />
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="热门评论" />
                                <TextBlock x:Name="CommentsCount" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource MoonCardMetaStyle}" />
                            </Grid>
                            <ProgressRing x:Name="CommentsRing" Width="20" Height="20" HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed" />
                            <ItemsRepeater x:Name="CommentsRepeater" ItemTemplate="{StaticResource BiliCommentTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="18" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock
                                x:Name="CommentsNote"
                                FontSize="12"
                                Style="{StaticResource MoonCardMetaStyle}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    x:Name="CommentsMoreButton"
                                    Click="OnMoreComments"
                                    Style="{StaticResource MoonGlassButtonStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock Text="加载更多评论" />
                                </Button>
                                <Button
                                    x:Name="BiliLinkButton"
                                    Click="OnLinkBiliFromPlayer"
                                    Style="{StaticResource MoonGlassButtonStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock Text="关联 B站账号" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 字幕 ===== -->
                <ScrollViewer x:Name="SubtitleView" Grid.Row="1" Padding="18,8,18,18" HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel Spacing="22">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Style="{StaticResource PanelLabelStyle}" Text="字幕" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="OnLoadSubtitleFile"
                                    FontSize="12"
                                    Style="{StaticResource MoonLinkButtonStyle}">
                                    <TextBlock Text="加载字幕文件…" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="SubtitleTrackList" Spacing="2" />
                        </StackPanel>
                        <StackPanel x:Name="SecondarySection" Spacing="6">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="第二字幕（双语）" />
                            <StackPanel x:Name="SecondaryTrackList" Spacing="2" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="样式" />
                            <StackPanel x:Name="SubtitleSliders" Spacing="2" />
                            <StackPanel x:Name="SubtitleChips" Margin="0,6,0,0" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PanelLabelStyle}" Text="字幕时间轴（本季记住）" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button AutomationProperties.Name="字幕提前 0.1 秒" Click="OnSubtitleEarlier" Style="{StaticResource MoonTitleBarButtonStyle}">
                                    <FontIcon FontSize="12" Glyph="&#xE738;" />
                                </Button>
                                <TextBlock
                                    x:Name="SubtitleDelayText"
                                    MinWidth="96"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="13"
                                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                                    TextAlignment="Center" />
                                <Button AutomationProperties.Name="字幕延后 0.1 秒" Click="OnSubtitleLater" Style="{StaticResource MoonTitleBarButtonStyle}">
                                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                                </Button>
                            </StackPanel>
                            <TextBlock FontSize="12" Style="{StaticResource MoonCardMetaStyle}" Text="快捷键：V 开关字幕 · Shift+V 切换字幕 · Z / X 提前 / 延后" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
