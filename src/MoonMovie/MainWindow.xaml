<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MoonMovie.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:vm="using:MoonMovie.ViewModels"
    Title="MoonMovie">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="{StaticResource MoonCanvasBrush}"
        Loaded="OnRootLoaded"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <DataTemplate x:Key="SuggestionTemplate" x:DataType="vm:SuggestionItem">
                <Grid Padding="0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Past queries end with 清除搜索记录; each can also be removed on its own. -->
                    <TextBlock
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource MoonTextSecondaryBrush}"
                        Text="{x:Bind Text}"
                        Visibility="{x:Bind ClearAllVisibility}" />
                    <Grid
                        Width="34"
                        Height="50"
                        Background="{StaticResource MoonSurfaceRaisedBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind PosterVisibility}">
                        <Image imaging:ImageEx.DecodeWidth="34" imaging:ImageEx.Url="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                    </Grid>
                    <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource MoonTextTertiaryBrush}"
                        Glyph="&#xE81C;"
                        Visibility="{x:Bind HistoryVisibility}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2"
                        Visibility="{x:Bind EntryVisibility}">
                        <TextBlock FontSize="14" Foreground="{StaticResource MoonTextPrimaryBrush}" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Meta}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="删除这条搜索记录"
                        Click="OnForgetQuery"
                        Style="{StaticResource MoonTitleBarButtonStyle}"
                        Tag="{x:Bind Text}"
                        ToolTipService.ToolTip="删除"
                        Visibility="{x:Bind HistoryVisibility}">
                        <FontIcon FontSize="10" Foreground="{StaticResource MoonTextTertiaryBrush}" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Invoked="OnSearchAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="O" Invoked="OnOpenFileAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="Left" Invoked="OnBackAccelerator" Modifiers="Menu" />
            <KeyboardAccelerator Key="Escape" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>

        <Frame x:Name="ContentFrame" FontFamily="{StaticResource MoonFontRegular}" Navigated="OnNavigated" />

        <!-- Keeps the title bar legible over bright artwork without a visible bar. -->
        <Rectangle x:Name="TitleScrim" Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#B30C0D10" />
                    <GradientStop Offset="1" Color="#000C0D10" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="AppTitleBar" Height="56" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                AutomationProperties.Name="返回"
                Click="OnBackClick"
                Style="{StaticResource MoonTitleBarButtonStyle}"
                ToolTipService.ToolTip="返回 (Esc)"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <!-- Wordmark -->
            <StackPanel
                x:Name="Wordmark"
                Grid.Column="2"
                Margin="24,0,28,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    x:Name="WordmarkLogo"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Opacity="0"
                    Source="ms-appx:///Assets/AppLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="WordmarkText"
                    VerticalAlignment="Center"
                    Opacity="0"
                    CharacterSpacing="20"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="16"
                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                    Text="MoonMovie" />
            </StackPanel>

            <SelectorBar
                x:Name="Nav"
                Grid.Column="3"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MoonFontRegular}"
                SelectionChanged="OnNavSelectionChanged">
                <SelectorBarItem Tag="home" Text="首页" />
                <SelectorBarItem Tag="movie" Text="电影" />
                <SelectorBarItem Tag="tv" Text="剧集" />
                <SelectorBarItem Tag="anime" Text="动漫" />
                <SelectorBarItem Tag="bili" Text="B站" />
                <SelectorBarItem Tag="library" Text="媒体库" />
            </SelectorBar>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="5"
                Width="300"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MoonFontRegular}"
                GotFocus="OnSearchGotFocus"
                ItemTemplate="{StaticResource SuggestionTemplate}"
                PlaceholderText="搜索电影、剧集、人物"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                TextChanged="OnSearchTextChanged"
                UpdateTextOnSelect="False" />

            <StackPanel
                x:Name="Actions"
                Grid.Column="6"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!-- The count sits over the button (not inside it, where the button's rounded clip cut it). -->
                <Grid>
                    <Button
                        x:Name="DownloadsButton"
                        AutomationProperties.Name="下载"
                        Click="OnDownloadsClick"
                        Style="{StaticResource MoonTitleBarButtonStyle}"
                        ToolTipService.ToolTip="下载">
                        <FontIcon FontSize="15" Glyph="&#xE896;" />
                    </Button>
                    <InfoBadge
                        x:Name="DownloadBadge"
                        Margin="0,2,1,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>
                <Button
                    AutomationProperties.Name="观看历史"
                    Click="OnHistoryClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="观看历史">
                    <FontIcon FontSize="15" Glyph="&#xE81C;" />
                </Button>
                <Button
                    AutomationProperties.Name="设置"
                    Click="OnSettingsClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="个人主页"
                    Click="OnProfileClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="个人主页">
                    <PersonPicture x:Name="ProfileAvatar" Width="28" Height="28" Initials="M" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- A new release: offered under the title bar until updated, skipped or closed. -->
        <InfoBar
            x:Name="UpdateBar"
            MaxWidth="720"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            BorderBrush="{StaticResource MoonCardStrokeBrush}"
            Margin="24,68,24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="UpdateNowButton" Click="OnUpdateNow" Content="立即更新" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Spacing="8">
                    <ProgressBar x:Name="UpdateProgress" Maximum="1" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton Padding="0" Click="OnUpdateNotes" Content="更新内容" />
                        <HyperlinkButton Padding="0" Click="OnUpdateSkip" Content="跳过此版本" />
                    </StackPanel>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Shown while files are dragged over the window. -->
        <Grid
            x:Name="DropOverlay"
            Background="#B30C0D10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Padding="48,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource MoonGlassAcrylicBrush}"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="10">
                    <FontIcon FontSize="34" Foreground="{StaticResource MoonTextPrimaryBrush}" Glyph="&#xE768;" />
                    <TextBlock
                        x:Name="DropTitle"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource MoonFontBold}"
                        FontSize="20"
                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                        Text="松开即可播放" />
                    <TextBlock
                        x:Name="DropCaption"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MoonMetaStyle}"
                        Text="视频文件直接播放，文件夹会加入本地媒体库" />
                </StackPanel>
            </Border>
        </Grid>
        <!--
            Startup: the logo on the canvas colour while the first page loads, then it flies into the title-bar
            wordmark as the cover fades. Composition only on the logo image (it hosts nothing); the cover and the
            ring use storyboards.
        -->
        <Grid x:Name="Splash">
            <Rectangle x:Name="SplashCover" Fill="{StaticResource MoonCanvasBrush}" />
            <Image
                x:Name="SplashLogo"
                Width="132"
                Height="132"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/AppLogoLarge.png"
                Stretch="Uniform" />
            <controls:DotsSpinner
                x:Name="SplashRing"
                Width="34"
                Height="34"
                Margin="0,240,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DotColor="#D9FFFFFF"
                IsActive="False"
                Opacity="0" />
        </Grid>
    </Grid>
</Window>
