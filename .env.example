# Copy to .env (gitignored). Every key is optional except a TMDB credential, which can also be entered in Settings.

# TMDB: an API key (v3) or a read access token (v4); https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# Optional mirrors when api.themoviedb.org / image.tmdb.org are unreachable
TMDB_BASE_URL=
TMDB_IMAGE_BASE=

# LogVar danmu_api server for danmaku (also editable in Settings)
LOGVAR_BASE_URL=
LOGVAR_TOKEN=
