<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.MpvLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:mpv="using:MoonMovie.Playback.Mpv"
    Background="Black">

    <!-- M0 engine lab: mpv picture, danmaku and XAML chrome stacked exactly like the real player will be. -->
    <Grid>
        <mpv:MpvVideoView x:Name="VideoView" />
        <controls:DanmakuOverlay x:Name="Danmaku" />

        <Border
            Margin="20,70,0,0"
            Padding="14,10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#B3000000"
            CornerRadius="8">
            <TextBlock
                x:Name="Stats"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="White"
                LineHeight="18" />
        </Border>

        <Grid
            Margin="24,0,24,20"
            Padding="16,10"
            VerticalAlignment="Bottom"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            ColumnSpacing="14"
            CornerRadius="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.Name="播放/暂停" Click="OnPlayPause" Style="{StaticResource MoonPlayerIconButtonStyle}">
                <FontIcon x:Name="PlayGlyph" FontSize="20" Glyph="&#xE769;" />
            </Button>
            <Slider
                x:Name="Seek"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsThumbToolTipEnabled="False"
                PointerCaptureLost="OnSeekReleased" />
            <TextBlock
                x:Name="TimeLabel"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                Foreground="White" />
            <Button Grid.Column="3" AutomationProperties.Name="画中画" Click="OnPip" Style="{StaticResource MoonPlayerIconButtonStyle}">
                <FontIcon FontSize="18" Glyph="&#xE8A7;" />
            </Button>
            <Button Grid.Column="4" AutomationProperties.Name="全屏" Click="OnFullScreen" Style="{StaticResource MoonPlayerIconButtonStyle}">
                <FontIcon FontSize="18" Glyph="&#xE740;" />
            </Button>
        </Grid>
    </Grid>
</Page>
