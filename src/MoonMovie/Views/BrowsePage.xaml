<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:MoonMovie.ViewModels"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid>
        <controls:AmbientBackdrop x:Name="Ambient" Opacity="0.55" />

        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="NaN"
            ViewChanged="OnScrollViewChanged">
            <StackPanel Padding="0,104,0,72">
                <StackPanel x:Name="Header" Margin="{StaticResource MoonGutter}">
                    <TextBlock Style="{StaticResource MoonOverlineStyle}" Text="浏览" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource MoonDisplayStyle}" Text="{x:Bind ViewModel.Title}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MoonMetaStyle}" Text="{x:Bind ViewModel.Tagline}" />

                    <ItemsRepeater
                        x:Name="FilterRepeater"
                        Margin="-2,30,0,0"
                        ItemTemplate="{StaticResource FilterGroupTemplate}"
                        ItemsSource="{x:Bind ViewModel.Groups}"
                        XYFocusKeyboardNavigation="Enabled">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <ItemsRepeater
                    x:Name="WallRepeater"
                    Margin="56,40,56,0"
                    ItemTemplate="{StaticResource WallPosterTemplate}"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    XYFocusKeyboardNavigation="Enabled">
                    <ItemsRepeater.Layout>
                        <controls:MasonryLayout ColumnSpacing="20" MinColumnWidth="180" RowSpacing="26" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <StackPanel
                    Margin="56,36,56,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="20"
                        Height="20"
                        MinWidth="20"
                        MinHeight="20"
                        IsActive="True"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="MessageText"
                        VerticalAlignment="Center"
                        Style="{StaticResource MoonMetaStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            Compact bar once the filters scroll away: the title bar floats on its upper half, the current
            selection sits in the lower half, and 筛选 brings the full filter rows back.
        -->
        <Grid
            x:Name="StickyBar"
            Height="112"
            VerticalAlignment="Top"
            Background="{StaticResource MoonChromeAcrylicBrush}"
            Opacity="0"
            Visibility="Collapsed">
            <Border BorderBrush="{StaticResource MoonHairlineBrush}" BorderThickness="0,0,0,1" />
            <Grid Height="56" Margin="56,0,48,0" VerticalAlignment="Bottom" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="18"
                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                    Text="{x:Bind ViewModel.Title}" />
                <TextBlock
                    x:Name="StickySummary"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource MoonMetaStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="2"
                    Height="36"
                    Padding="14,0"
                    VerticalAlignment="Center"
                    Click="OnShowFilters"
                    FontSize="13"
                    Style="{StaticResource MoonGlassButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE71C;" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
