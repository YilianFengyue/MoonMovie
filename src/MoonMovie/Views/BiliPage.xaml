<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.BiliPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollMode="Disabled"
            VerticalAnchorRatio="NaN"
            ViewChanged="OnScrollViewChanged">
            <StackPanel Padding="0,104,0,72">
                <StackPanel Margin="{StaticResource MoonGutter}">
                    <TextBlock Style="{StaticResource MoonOverlineStyle}" Text="哔哩哔哩" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource MoonDisplayStyle}" Text="B站" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MoonMetaStyle}" Text="正版番剧影视、热门视频，还有你的追番和收藏" />
                    <SelectorBar x:Name="TabBar" Margin="-12,22,0,0" SelectionChanged="OnTabChanged">
                        <SelectorBarItem IsSelected="True" Tag="Shows" Text="番剧影视" />
                        <SelectorBarItem Tag="Videos" Text="视频" />
                        <SelectorBarItem Tag="Mine" Text="我的" />
                    </SelectorBar>
                </StackPanel>

                <!-- ===== 番剧影视: this week's new episodes, then the licensed library ===== -->
                <StackPanel x:Name="ShowsPanel">
                    <controls:MediaRow
                        x:Name="TimelineRow"
                        Margin="0,32,0,0"
                        ItemTemplate="{StaticResource BiliTimelineCardTemplate}"
                        ItemsSource="{x:Bind ViewModel.Timeline}"
                        Spacing="16"
                        Title="新番时间表"
                        Visibility="Collapsed">
                        <controls:MediaRow.HeaderContent>
                            <ContentControl
                                Margin="0,2,0,0"
                                Content="{x:Bind ViewModel.DayGroup, Mode=OneWay}"
                                ContentTemplate="{StaticResource ChipRowTemplate}"
                                IsTabStop="False" />
                        </controls:MediaRow.HeaderContent>
                    </controls:MediaRow>

                    <StackPanel Margin="56,36,56,0" Spacing="18">
                        <TextBlock Style="{StaticResource MoonSectionTitleStyle}" Text="片库" />
                        <ItemsRepeater
                            Margin="-2,0,0,0"
                            ItemTemplate="{StaticResource FilterGroupTemplate}"
                            ItemsSource="{x:Bind ViewModel.LibraryGroups}"
                            XYFocusKeyboardNavigation="Enabled">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ItemsRepeater
                            Margin="0,14,0,0"
                            ItemTemplate="{StaticResource BiliSeasonTileTemplate}"
                            ItemsSource="{x:Bind ViewModel.Library}"
                            XYFocusKeyboardNavigation="Enabled">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="20"
                                    MinItemWidth="168"
                                    MinRowSpacing="26" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>

                <!-- ===== 视频: 热门 / 排行榜 ===== -->
                <StackPanel x:Name="VideosPanel" Margin="56,32,56,0" Spacing="18" Visibility="Collapsed">
                    <ContentControl
                        Margin="-2,0,0,0"
                        Content="{x:Bind ViewModel.VideoGroup}"
                        ContentTemplate="{StaticResource ChipRowTemplate}"
                        IsTabStop="False" />
                    <ItemsRepeater
                        ItemTemplate="{StaticResource BiliVideoTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Videos}"
                        XYFocusKeyboardNavigation="Enabled">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="20"
                                MinItemWidth="260"
                                MinRowSpacing="28" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!-- ===== 我的: the linked account's 追番, 追剧, 稍后再看, 收藏夹 ===== -->
                <StackPanel x:Name="MinePanel" Visibility="Collapsed">
                    <Border
                        x:Name="LinkCard"
                        MaxWidth="640"
                        Margin="56,32,56,0"
                        Padding="22,20"
                        HorizontalAlignment="Left"
                        Background="#0FFFFFFF"
                        BorderBrush="#17FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="52"
                                Height="52"
                                VerticalAlignment="Center"
                                Background="#FB7299"
                                CornerRadius="14">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="15"
                                    Foreground="White"
                                    Text="bili" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    FontFamily="{StaticResource MoonFontBold}"
                                    FontSize="16"
                                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                                    Text="关联 B站账号" />
                                <TextBlock Style="{StaticResource MoonCardMetaStyle}" Text="关联后，这里会出现你的追番、追剧、稍后再看和收藏夹。" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Height="38"
                                Padding="18,0"
                                VerticalAlignment="Center"
                                Click="OnLinkClick"
                                Style="{StaticResource MoonPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xED14;" />
                                    <TextBlock Text="扫码关联" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="MineContent" Visibility="Collapsed">
                        <controls:MediaRow
                            x:Name="FollowingRow"
                            Margin="0,32,0,0"
                            ItemTemplate="{StaticResource BiliSeasonCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.Following}"
                            Title="我的追番" />
                        <controls:MediaRow
                            x:Name="DramasRow"
                            Margin="0,32,0,0"
                            ItemTemplate="{StaticResource BiliSeasonCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.Dramas}"
                            Title="我的追剧" />
                        <controls:MediaRow
                            x:Name="WatchLaterRow"
                            Margin="0,32,0,0"
                            ItemTemplate="{StaticResource BiliVideoCardTemplate}"
                            ItemsSource="{x:Bind ViewModel.WatchLater}"
                            Spacing="20"
                            Title="稍后再看" />
                        <StackPanel x:Name="FolderSection" Margin="56,32,56,0" Spacing="18">
                            <TextBlock Style="{StaticResource MoonSectionTitleStyle}" Text="收藏夹" />
                            <ContentControl
                                Margin="-2,0,0,0"
                                Content="{x:Bind ViewModel.FolderGroup, Mode=OneWay}"
                                ContentTemplate="{StaticResource ChipRowTemplate}"
                                IsTabStop="False" />
                            <ItemsRepeater
                                ItemTemplate="{StaticResource BiliVideoTileTemplate}"
                                ItemsSource="{x:Bind ViewModel.FolderItems}"
                                XYFocusKeyboardNavigation="Enabled">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="20"
                                        MinItemWidth="260"
                                        MinRowSpacing="28" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                        <TextBlock
                            x:Name="MineEmpty"
                            Margin="56,32,56,0"
                            Style="{StaticResource MoonMetaStyle}"
                            Text="这个账号还没有追番、稍后再看或收藏。"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="56,36,56,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="20"
                        Height="20"
                        MinWidth="20"
                        MinHeight="20"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="MessageText"
                        VerticalAlignment="Center"
                        Style="{StaticResource MoonMetaStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
