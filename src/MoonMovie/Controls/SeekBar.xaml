<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoonMovie.Controls.SeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36"
    IsTabStop="False">

    <!-- Tall transparent hit area; the visible track is thin and thickens on hover. -->
    <Grid
        x:Name="HitArea"
        Background="Transparent"
        PointerCanceled="OnPointerCanceled"
        PointerCaptureLost="OnPointerCaptureLost"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased">

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <!-- Time preview that follows the pointer. -->
            <Border
                x:Name="Preview"
                Canvas.Top="-30"
                Padding="8,3,8,4"
                Background="#E6141519"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0">
                <TextBlock
                    x:Name="PreviewText"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="12"
                    Foreground="White"
                    Text="0:00" />
            </Border>
        </Canvas>

        <Grid x:Name="Track" Height="4" VerticalAlignment="Center" CornerRadius="2">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TrackScale" CenterY="2" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Background="#33FFFFFF" />
            <Border x:Name="BufferedFill" HorizontalAlignment="Left" Background="#59FFFFFF" />
            <Border x:Name="HoverFill" HorizontalAlignment="Left" Background="#33FFFFFF" Opacity="0" />
            <Border x:Name="PlayedFill" HorizontalAlignment="Left" Background="White" />
            <!-- Chapter / intro / outro marks: small gaps cut into the track. -->
            <Canvas x:Name="Marks" />
        </Grid>

        <Ellipse
            x:Name="Thumb"
            Width="14"
            Height="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="White"
            IsHitTestVisible="False"
            Opacity="0">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbOffset" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
