<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource MoonCanvasBrush}">

    <Page.Resources>
        <!-- Neutral sliders, same as the player. -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#4DFFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#33000000" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MoonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MoonCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="RowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="22,16,22,16" />
            <Setter Property="ColumnSpacing" Value="24" />
            <Setter Property="BorderBrush" Value="{StaticResource MoonHairlineBrush}" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MoonTextPrimaryBrush}" />
        </Style>
        <Style x:Key="RowCaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MoonTextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource MoonOverlineStyle}">
            <Setter Property="Margin" Value="4,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalAnchorRatio="NaN">
        <StackPanel
            MaxWidth="980"
            Padding="56,104,56,72"
            HorizontalAlignment="Left"
            Spacing="36">
            <StackPanel>
                <TextBlock Style="{StaticResource MoonOverlineStyle}" Text="偏好" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource MoonDisplayStyle}" Text="设置" />
            </StackPanel>

            <!-- ===== 播放 ===== -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionStyle}" Text="播放" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="自动播放下一集" />
                                <TextBlock x:Name="AutoNextChipsCaption" Style="{StaticResource RowCaptionStyle}" Text="剧集播完后接着放下一集；片尾 30 秒会先给出提示，可以取消" />
                            </StackPanel>
                            <StackPanel x:Name="AutoNextChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="播放内核" />
                                <TextBlock x:Name="EngineChipsCaption" Style="{StaticResource RowCaptionStyle}" Text="mpv：几乎所有格式、ASS 特效字幕、HDR、超分；系统内核作为备用。下次打开播放器时生效" />
                            </StackPanel>
                            <StackPanel x:Name="EngineChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="画质档位" />
                                <TextBlock x:Name="QualityChipsHostCaption" Style="{StaticResource RowCaptionStyle}" Text="" />
                            </StackPanel>
                            <StackPanel x:Name="QualityChipsHost" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="运动平滑" />
                                <TextBlock x:Name="InterpolationChipsCaption" Style="{StaticResource RowCaptionStyle}" Text="把 24 帧电影重采样到屏幕刷新率，高刷屏上镜头平移不抖（略增显卡负担）" />
                            </StackPanel>
                            <StackPanel x:Name="InterpolationChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="字幕样式" />
                                <TextBlock x:Name="SubtitleStyleChipsCaption" Style="{StaticResource RowCaptionStyle}" Text="背景板：字幕下加半透明底；统一样式：番剧特效字幕也按统一字体字号显示" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleStyleChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="声音" />
                                <TextBlock x:Name="AudioChipsHostCaption" Style="{StaticResource RowCaptionStyle}" Text="夜间模式：压低爆炸声、提亮对白；源码输出：杜比 / DTS 原样送功放" />
                            </StackPanel>
                            <StackPanel x:Name="AudioChipsHost" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 弹幕 ===== -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionStyle}" Text="弹幕" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="播放时显示弹幕" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="播放中按 D 随时开关，按 B 打开弹幕面板" />
                            </StackPanel>
                            <Border x:Name="DanmakuOnHost" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="样式" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="不透明度、字号与滚动速度" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="不透明度" />
                                    <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Style="{StaticResource MoonCardMetaStyle}" />
                                </Grid>
                                <Slider x:Name="OpacitySlider" IsThumbToolTipEnabled="False" Maximum="100" Minimum="20" StepFrequency="5" ValueChanged="OnSliderChanged" />
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="字号" />
                                    <TextBlock x:Name="FontValue" HorizontalAlignment="Right" Style="{StaticResource MoonCardMetaStyle}" />
                                </Grid>
                                <Slider x:Name="FontSlider" IsThumbToolTipEnabled="False" Maximum="160" Minimum="60" StepFrequency="10" ValueChanged="OnSliderChanged" />
                                <Grid>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MoonTextSecondaryBrush}" Text="滚动速度" />
                                    <TextBlock x:Name="SpeedValue" HorizontalAlignment="Right" Style="{StaticResource MoonCardMetaStyle}" />
                                </Grid>
                                <Slider x:Name="SpeedSlider" IsThumbToolTipEnabled="False" Maximum="200" Minimum="50" StepFrequency="10" ValueChanged="OnSliderChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="显示区域" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="弹幕最多铺到画面的哪里" />
                            </StackPanel>
                            <StackPanel x:Name="AreaChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>

                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="弹幕密度" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="智能：按显示区域控制每秒数量，密集时优先保留大家都在刷的和读得通的，过滤打卡、日期、纯数字" />
                            </StackPanel>
                            <StackPanel x:Name="DensityChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>

                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="显示内容" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="顶部、底部固定弹幕；把几秒内重复刷屏的同一句合并成一条" />
                            </StackPanel>
                            <StackPanel x:Name="KindChips" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                        </Grid>

                        <Grid Style="{StaticResource RowStyle}" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="屏蔽词" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="包含这些词的弹幕不显示。用空格、逗号或换行分隔；写成 /正则/ 可以按正则匹配" />
                            </StackPanel>
                            <TextBox
                                x:Name="BlockWordsBox"
                                Grid.Row="1"
                                MinHeight="72"
                                AcceptsReturn="True"
                                LostFocus="OnBlockWordsLostFocus"
                                PlaceholderText="例如：剧透 前方高能 /^6+$/"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 弹幕服务器 ===== -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionStyle}" Text="弹幕服务器" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="服务器地址" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="LogVar 弹幕 API（danmu_api）的地址；留空则使用 .env 中的配置" />
                            </StackPanel>
                            <TextBox
                                x:Name="ServerBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                LostFocus="OnServerLostFocus"
                                PlaceholderText="https://example.com" />
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="访问令牌" />
                                <TextBlock Style="{StaticResource RowCaptionStyle}" Text="服务器的 TOKEN，会拼在地址后面" />
                            </StackPanel>
                            <TextBox
                                x:Name="TokenBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                LostFocus="OnServerLostFocus"
                                PlaceholderText="留空则使用 .env 中的配置" />
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="连接状态" />
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Spacing="8">
                                    <Ellipse
                                        x:Name="ServerDot"
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="#80FFFFFF" />
                                    <TextBlock x:Name="ServerStatus" FontSize="12" Foreground="{StaticResource MoonTextTertiaryBrush}" Text="未检测" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                x:Name="TestButton"
                                Grid.Column="1"
                                Height="36"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Click="OnTestServer"
                                FontSize="13"
                                Style="{StaticResource MoonGlassButtonStyle}">
                                <TextBlock Text="测试连接" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 存储 ===== -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionStyle}" Text="存储" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="图片缓存" />
                                <TextBlock x:Name="ImageCacheText" Style="{StaticResource RowCaptionStyle}" Text="正在计算…" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Height="36"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Click="OnClearImages"
                                FontSize="13"
                                Style="{StaticResource MoonGlassButtonStyle}">
                                <TextBlock Text="清理" />
                            </Button>
                        </Grid>
                        <Grid BorderThickness="0,0,0,1" Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="数据缓存" />
                                <TextBlock x:Name="DataCacheText" Style="{StaticResource RowCaptionStyle}" Text="正在计算…" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Height="36"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Click="OnClearData"
                                FontSize="13"
                                Style="{StaticResource MoonGlassButtonStyle}">
                                <TextBlock Text="清理" />
                            </Button>
                        </Grid>
                        <Grid Style="{StaticResource RowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="数据文件夹" />
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource RowCaptionStyle}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Height="36"
                                Padding="16,0"
                                VerticalAlignment="Center"
                                Click="OnOpenDataFolder"
                                FontSize="13"
                                Style="{StaticResource MoonGlassButtonStyle}">
                                <TextBlock Text="打开" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 关于 ===== -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionStyle}" Text="关于" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid Style="{StaticResource RowStyle}">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Style="{StaticResource RowCaptionStyle}" Text="影视资料与图片来自 TMDB；本产品使用 TMDB API，但未经 TMDB 认可或认证。片源来自公开资源站，弹幕由你配置的服务器提供。" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
