<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MoonMovie design tokens.
        The canvas is a neutral near-black so colour comes from the artwork, not from the chrome.
    -->

    <!-- Typography: HarmonyOS Sans SC ships with the app (Regular + Bold faces). -->
    <FontFamily x:Key="MoonFontRegular">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="MoonFontBold">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Bold.ttf#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>

    <!-- Surfaces -->
    <Color x:Key="MoonCanvasColor">#0C0D10</Color>
    <Color x:Key="MoonCanvasTransparentColor">#000C0D10</Color>
    <Color x:Key="MoonSurfaceColor">#17181C</Color>
    <Color x:Key="MoonSurfaceRaisedColor">#1F2025</Color>

    <SolidColorBrush x:Key="MoonCanvasBrush" Color="{StaticResource MoonCanvasColor}" />
    <SolidColorBrush x:Key="MoonSurfaceBrush" Color="{StaticResource MoonSurfaceColor}" />
    <SolidColorBrush x:Key="MoonSurfaceRaisedBrush" Color="{StaticResource MoonSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="MoonHairlineBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="MoonCardStrokeBrush" Color="#1AFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="MoonTextPrimaryBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="MoonTextSecondaryBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="MoonTextTertiaryBrush" Color="#80FFFFFF" />

    <!-- Glass controls that sit on top of artwork -->
    <SolidColorBrush x:Key="MoonGlassBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="MoonGlassHoverBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="MoonGlassPressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="MoonGlassStrokeBrush" Color="#24FFFFFF" />

    <!-- Primary "Play" action: neutral light fill, dark label -->
    <SolidColorBrush x:Key="MoonPrimaryBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="MoonPrimaryHoverBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MoonPrimaryPressedBrush" Color="#D9D9DE" />
    <SolidColorBrush x:Key="MoonOnPrimaryBrush" Color="#0C0D10" />

    <CornerRadius x:Key="MoonCardRadius">6</CornerRadius>
    <CornerRadius x:Key="MoonButtonRadius">6</CornerRadius>

    <!-- Page gutters: everything aligns to the same left edge as the hero copy. -->
    <Thickness x:Key="MoonGutter">56,0,56,0</Thickness>
    <x:Double x:Key="MoonGutterLeft">56</x:Double>

    <!-- Type ramp -->
    <Style x:Key="MoonDisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontBold}" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="LineHeight" Value="60" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <Style x:Key="MoonSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextPrimaryBrush}" />
    </Style>

    <Style x:Key="MoonBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MoonMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextSecondaryBrush}" />
    </Style>

    <Style x:Key="MoonCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MoonCardMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontRegular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MoonOverlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MoonFontBold}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource MoonTextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
