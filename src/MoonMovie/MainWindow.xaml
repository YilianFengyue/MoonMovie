<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MoonMovie.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:vm="using:MoonMovie.ViewModels"
    Title="MoonMovie">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="{StaticResource MoonCanvasBrush}"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <DataTemplate x:Key="SuggestionTemplate" x:DataType="vm:SuggestionItem">
                <Grid Padding="0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="34"
                        Height="50"
                        Background="{StaticResource MoonSurfaceRaisedBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind PosterVisibility}">
                        <Image imaging:ImageEx.DecodeWidth="34" imaging:ImageEx.Url="{x:Bind PosterUrl}" Stretch="UniformToFill" />
                    </Grid>
                    <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource MoonTextTertiaryBrush}"
                        Glyph="&#xE81C;"
                        Visibility="{x:Bind HistoryVisibility}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" Foreground="{StaticResource MoonTextPrimaryBrush}" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MoonCardMetaStyle}" Text="{x:Bind Meta}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Invoked="OnSearchAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="O" Invoked="OnOpenFileAccelerator" Modifiers="Control" />
            <KeyboardAccelerator Key="Left" Invoked="OnBackAccelerator" Modifiers="Menu" />
            <KeyboardAccelerator Key="Escape" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>

        <Frame x:Name="ContentFrame" FontFamily="{StaticResource MoonFontRegular}" Navigated="OnNavigated" />

        <!-- Keeps the title bar legible over bright artwork without a visible bar. -->
        <Rectangle x:Name="TitleScrim" Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#B30C0D10" />
                    <GradientStop Offset="1" Color="#000C0D10" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="AppTitleBar" Height="56" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                AutomationProperties.Name="返回"
                Click="OnBackClick"
                Style="{StaticResource MoonTitleBarButtonStyle}"
                ToolTipService.ToolTip="返回 (Esc)"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <!-- Wordmark -->
            <StackPanel
                x:Name="Wordmark"
                Grid.Column="2"
                Margin="24,0,28,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/AppLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    CharacterSpacing="20"
                    FontFamily="{StaticResource MoonFontBold}"
                    FontSize="16"
                    Foreground="{StaticResource MoonTextPrimaryBrush}"
                    Text="MoonMovie" />
            </StackPanel>

            <SelectorBar
                x:Name="Nav"
                Grid.Column="3"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MoonFontRegular}"
                SelectionChanged="OnNavSelectionChanged">
                <SelectorBarItem Tag="home" Text="首页" />
                <SelectorBarItem Tag="movie" Text="电影" />
                <SelectorBarItem Tag="tv" Text="剧集" />
                <SelectorBarItem Tag="anime" Text="动漫" />
                <SelectorBarItem Tag="bili" Text="B站" />
                <SelectorBarItem Tag="library" Text="媒体库" />
            </SelectorBar>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="5"
                Width="300"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource MoonFontRegular}"
                GotFocus="OnSearchGotFocus"
                ItemTemplate="{StaticResource SuggestionTemplate}"
                PlaceholderText="搜索电影、剧集、人物"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                TextChanged="OnSearchTextChanged"
                UpdateTextOnSelect="False" />

            <StackPanel
                x:Name="Actions"
                Grid.Column="6"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    AutomationProperties.Name="下载"
                    Click="OnDownloadsClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="下载">
                    <Grid>
                        <FontIcon FontSize="15" Glyph="&#xE896;" />
                        <Border
                            x:Name="DownloadBadge"
                            MinWidth="15"
                            Height="15"
                            Margin="0,-9,-11,0"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="7.5"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="DownloadBadgeText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="Black" />
                        </Border>
                    </Grid>
                </Button>
                <Button
                    AutomationProperties.Name="观看历史"
                    Click="OnHistoryClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="观看历史">
                    <FontIcon FontSize="15" Glyph="&#xE81C;" />
                </Button>
                <Button
                    AutomationProperties.Name="设置"
                    Click="OnSettingsClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="个人主页"
                    Click="OnProfileClick"
                    Style="{StaticResource MoonTitleBarButtonStyle}"
                    ToolTipService.ToolTip="个人主页">
                    <PersonPicture x:Name="ProfileAvatar" Width="28" Height="28" Initials="M" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Shown while files are dragged over the window. -->
        <Grid
            x:Name="DropOverlay"
            Background="#B30C0D10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Padding="48,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource MoonGlassAcrylicBrush}"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="10">
                    <FontIcon FontSize="34" Foreground="{StaticResource MoonTextPrimaryBrush}" Glyph="&#xE768;" />
                    <TextBlock
                        x:Name="DropTitle"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource MoonFontBold}"
                        FontSize="20"
                        Foreground="{StaticResource MoonTextPrimaryBrush}"
                        Text="松开即可播放" />
                    <TextBlock
                        x:Name="DropCaption"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MoonMetaStyle}"
                        Text="视频文件直接播放，文件夹会加入本地媒体库" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
