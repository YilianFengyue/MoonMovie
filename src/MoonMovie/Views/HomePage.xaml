<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoonMovie.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonMovie.Controls"
    xmlns:imaging="using:MoonMovie.Imaging"
    xmlns:themes="using:MoonMovie.Themes"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:MoonMovie.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required"
    XYFocusKeyboardNavigation="Enabled">

    <Page.Resources>
        <themes:WallTemplateSelector
            x:Key="WallSelector"
            Landscape="{StaticResource WallLandscapeTemplate}"
            Poster="{StaticResource WallPosterTemplate}" />
    </Page.Resources>

    <Grid>
        <controls:AmbientBackdrop x:Name="Ambient" />

        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalAnchorRatio="NaN"
            ViewChanged="OnScrollViewChanged">
            <StackPanel>
                <!-- ===== Spotlight ===== -->
                <Grid x:Name="Hero" Height="760">
                    <Grid x:Name="HeroParallax" VerticalAlignment="Bottom">
                        <StackPanel
                            x:Name="HeroCopy"
                            MaxWidth="620"
                            Margin="56,0,56,132"
                            HorizontalAlignment="Left"
                            PointerEntered="OnHeroPointerEntered"
                            PointerExited="OnHeroPointerExited">

                            <TextBlock x:Name="HeroOverline" Style="{StaticResource MoonOverlineStyle}" />

                            <!-- Title slot: logo art when it reads well on dark, set type otherwise. -->
                            <Grid Margin="0,16,0,0" MinHeight="64">
                                <Image
                                    x:Name="HeroLogo"
                                    MaxWidth="460"
                                    MaxHeight="150"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    imaging:ImageEx.DecodeWidth="460"
                                    Stretch="Uniform" />
                                <TextBlock x:Name="HeroTitle" VerticalAlignment="Bottom" Style="{StaticResource MoonDisplayStyle}" />
                            </Grid>

                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal" Spacing="14">
                                <StackPanel x:Name="HeroRatingPanel" Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#F2C94C"
                                        Glyph="&#xE735;" />
                                    <TextBlock
                                        x:Name="HeroRating"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MoonFontBold}"
                                        FontSize="14"
                                        Foreground="{StaticResource MoonTextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="HeroMeta" VerticalAlignment="Center" Style="{StaticResource MoonMetaStyle}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="HeroOverview"
                                Margin="0,14,0,0"
                                MaxLines="3"
                                Style="{StaticResource MoonBodyStyle}" />

                            <StackPanel Margin="0,28,0,0" Orientation="Horizontal" Spacing="12">
                                <Button x:Name="HeroPlayButton" Click="OnHeroOpen" Style="{StaticResource MoonPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon FontSize="16" Glyph="&#xF5B0;" />
                                        <TextBlock Text="播放" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnHeroOpen" Style="{StaticResource MoonGlassButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon FontSize="16" Glyph="&#xE946;" />
                                        <TextBlock Text="详情" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="HeroFavoriteButton"
                                    Padding="0"
                                    AutomationProperties.Name="收藏"
                                    Click="OnHeroFavorite"
                                    Style="{StaticResource MoonGlassButtonStyle}"
                                    ToolTipService.ToolTip="收藏">
                                    <FontIcon x:Name="HeroFavoriteIcon" FontSize="16" Glyph="&#xE734;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Page indicators; the active one stretches. -->
                        <StackPanel
                            x:Name="HeroPager"
                            Margin="56,0,0,84"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="6" />
                    </Grid>
                </Grid>

                <!-- ===== Shelves ===== -->
                <controls:MediaRow
                    x:Name="ContinueRow"
                    Margin="0,-56,0,30"
                    ItemTemplate="{StaticResource ContinueCardTemplate}"
                    ItemsSource="{x:Bind ViewModel.Continue}"
                    Title="继续观看"
                    Visibility="Collapsed">
                    <controls:MediaRow.HeaderContent>
                        <Button
                            Click="OnOpenLibrary"
                            FontSize="13"
                            Style="{StaticResource MoonLinkButtonStyle}">
                            <TextBlock Text="全部" />
                        </Button>
                    </controls:MediaRow.HeaderContent>
                </controls:MediaRow>

                <ItemsRepeater x:Name="RowsRepeater" Margin="0,-56,0,0" ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="30" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeRowViewModel">
                            <controls:MediaRow
                                IsLandscape="{x:Bind IsLandscape}"
                                ItemsSource="{x:Bind Items}"
                                Title="{x:Bind Title}"
                                Visibility="{x:Bind IsLoaded, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- ===== Discover wall ===== -->
                <StackPanel Margin="56,64,56,80">
                    <TextBlock Style="{StaticResource MoonSectionTitleStyle}" Text="发现" />
                    <TextBlock
                        Margin="0,4,0,20"
                        Style="{StaticResource MoonCardMetaStyle}"
                        FontSize="13"
                        Text="此刻最受关注的电影与剧集" />
                    <ItemsRepeater
                        x:Name="WallRepeater"
                        ItemTemplate="{StaticResource WallSelector}"
                        ItemsSource="{x:Bind ViewModel.Discover}"
                        XYFocusKeyboardNavigation="Enabled">
                        <ItemsRepeater.Layout>
                            <controls:MasonryLayout ColumnSpacing="20" MinColumnWidth="220" RowSpacing="26" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <TextBlock
                    x:Name="ErrorText"
                    Margin="56,0,56,80"
                    Style="{StaticResource MoonMetaStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
